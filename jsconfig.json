{
  "compilerOptions": {
    "paths": {
      "component/*": ["./src/component/*"],
      "core/*": ["./src/core/*"],
      "error/*": ["./src/error/*"],
      "feature/*": ["./src/feature/*"],
      "func/*": ["./src/func/*"],
      "hooks/*": ["./src/hooks/*"]
    },
    "types": ["vite/client", "vite-plugin-monkey/client"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}
