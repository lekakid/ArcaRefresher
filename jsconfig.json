{
  "compilerOptions": {
    "paths": {
      "component/*": ["./src/component/*"],
      "store/*": ["./src/store/*"],
      "theme/*": ["./src/theme/*"],
      "error/*": ["./src/error/*"],
      "feature/*": ["./src/feature/*"],
      "hooks/*": ["./src/hooks/*"],
      "func/*": ["./src/func/*"],
      "constants/*": ["./src/constants/*"]
    },
    "types": ["vite/client", "vite-plugin-monkey/client"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}
